<?php
// Generic Folk worker entry point.
// Framework bootstrap is done via $GLOBALS['folk_worker_boot_hook']
// registered by the framework adapter (folk-laravel, folk-spiral, etc.)

$autoload = $GLOBALS['_composer_autoload_path']
    ?? dirname(__DIR__) . '/vendor/autoload.php';

if (!file_exists($autoload)) {
    fwrite(STDERR, "folk-worker: vendor/autoload.php not found.\n");
    exit(1);
}

// Normalize the autoload path: the Composer bin-proxy sets _composer_autoload_path
// with a literal ".." that string path ops do not collapse. realpath() expands it,
// keeping the autoload logic aligned with the adapter bin/folk-server entrypoints.
$autoload = realpath($autoload);

require $autoload;

$loop = new \Folk\Sdk\Worker\WorkerLoop();

if (isset($GLOBALS['folk_worker_boot_hook'])) {
    ($GLOBALS['folk_worker_boot_hook'])($loop);
}

$loop->run();
