{
    "name": "folk/sdk",
    "description": "Universal PHP SDK for Folk application server",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Folk-Project/folk-sdk",
    "keywords": ["folk", "php", "sdk", "worker"],
    "authors": [
        { "name": "Folk Contributors" }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Folk\\Sdk\\": "src/"
        }
    },
    "bin": ["bin/folk-worker"],
    "minimum-stability": "stable",
    "suggest": {
        "ext-folk": "Folk PHP extension — install via: pie install folk-project/ext-folk",
        "psr/http-factory": "Required for PsrHttpHandler (PSR-7 framework integration)"
    },
    "require-dev": {
        "psr/http-factory": "^1.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    }
}
